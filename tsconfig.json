{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": ["parser/**/*", "dependency-engine/**/*", "backend/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "sample-consumers"]
}
